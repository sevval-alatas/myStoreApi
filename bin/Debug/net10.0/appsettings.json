{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=mystore.db"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "MyStoreApi",
    "Audience": "MyStoreClient",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },

  "AllowedHosts": "*"
}
